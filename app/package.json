{
  "name": "nexus",
  "productName": "NEXUS",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS – lokaler Rahmen für deine KIs: Projekte, Desks, Claude Code und Web-KIs an einem Ort",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
