{
  "name": "nexus",
  "productName": "NEXUS",
  "version": "0.3.0",
  "private": true,
  "description": "NEXUS – lokaler Rahmen für deine KIs: Projekte, Desks, Claude Code und Web-KIs an einem Ort",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "lint": "eslint .",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --win dir --publish never",
    "release": "node scripts/release.js",
    "screenshots": "node scripts/screenshots.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never -c.npmRebuild=true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1"
  },
  "author": {
    "name": "CaseyMazey",
    "email": "253219934+CaseyMazey@users.noreply.github.com"
  },
  "homepage": "https://github.com/CaseyMazey/NEXUS",
  "build": {
    "appId": "io.github.caseymazey.nexus",
    "productName": "NEXUS",
    "copyright": "CaseyMazey",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "locales/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon-1024.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NEXUS-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CaseyMazey",
        "repo": "NEXUS",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "NEXUS-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "NEXUS",
      "artifactName": "NEXUS-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon-1024.png",
      "category": "Utility",
      "executableName": "nexus",
      "synopsis": "Alle deine KIs an einem Ort – sortiert nach Projekten",
      "artifactName": "NEXUS-linux-${arch}.${ext}"
    },
    "deb": {
      "packageName": "nexus-ai"
    }
  },
  "license": "MIT"
}
