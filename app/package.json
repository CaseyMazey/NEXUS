{
  "name": "nexus",
  "productName": "NEXUS",
  "version": "0.1.2",
  "private": true,
  "description": "NEXUS – lokaler Rahmen für deine KIs: Projekte, Desks, Claude Code und Web-KIs an einem Ort",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "lint": "eslint .",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --win dir --publish never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1"
  },
  "author": "CaseyMazey",
  "homepage": "https://github.com/CaseyMazey/NEXUS",
  "build": {
    "appId": "io.github.caseymazey.nexus",
    "productName": "NEXUS",
    "copyright": "CaseyMazey",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "locales/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NEXUS-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "CaseyMazey",
        "repo": "NEXUS",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "license": "MIT"
}
